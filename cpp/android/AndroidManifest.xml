<?xml version="1.0" encoding="utf-8"?>
<!-- Forcetris on Android: one SDL activity, both orientations, hardware
     keyboards welcome. configChanges keeps a rotation or a keyboard
     attaching from tearing the activity down - SDL reports it as a window
     resize and the game relays out. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="net.kjh.forcetris"
    android:versionCode="1"
    android:versionName="1.0"
    android:installLocation="auto">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <application android:label="Forcetris"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:extractNativeLibs="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
        <activity android:name="net.kjh.forcetris.MainActivity"
            android:label="Forcetris"
            android:exported="true"
            android:launchMode="singleInstance"
            android:screenOrientation="fullUser"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
