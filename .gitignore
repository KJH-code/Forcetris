__pycache__/
*.py[cod]

# Save data written next to the game at runtime: scores, and the player's profile.
data/*.dat
data/*.json
data/replays/
data/back/*.bak

# Crash dumps and screenshots.
crashdump.log
screenshots/*.png

# cx_Freeze output, and the C++ build trees (native and cross).
build/
dist/
cpp/build*/
reference.txt

# What the test run leaves behind. ctest writes Testing/ wherever it is
# invoked from, and fusecheck writes its own replay shelf and score table
# next to it - all three are output, not fixtures, and all three were
# committed by accident. The tests create what they need.
Testing/
fusecheck-replays/
fusecheck-scores/
